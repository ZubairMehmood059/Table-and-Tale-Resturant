{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "dev:client": "node ./node_modules/vite/bin/vite.js",
    "build": "node scripts/build.mjs",
    "build:client": "node ./node_modules/vite/bin/vite.js build",
    "build:server": "node -e \"import('esbuild').then(e => e.build({ entryPoints: ['server.ts'], bundle: true, platform: 'node', packages: 'external', format: 'esm', outfile: 'server.js' }))\"",
    "start": "node server.js",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "clean": "node -e \"import('fs').then(fs => { fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('server.js', { force: true }); })\"",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node --import tsx tests/api.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
