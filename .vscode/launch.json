{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Dev Server (Fullstack)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx", "server.ts"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Production Server (server.js)",
      "program": "${workspaceFolder}/server.js",
      "preLaunchTask": "npm: build",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Integration Tests",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx", "tests/api.test.ts"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
